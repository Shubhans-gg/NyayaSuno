# NyayaSuno Environment Configuration - Scaler x Wispr Flow Hackathon
ENVIRONMENT=development
DEBUG=True

# Security & JWT
JWT_SECRET=nyayasuno-super-secret-jwt-key-2026-hackathon
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- SPEECH-TO-TEXT: WISPR FLOW (Official Hackathon Engine) ---
# Obtain your API key from the Wispr Flow Platform (https://platform.wisprflow.ai)
WISPR_FLOW_API_KEY=your_wispr_flow_api_key_here
WISPR_FLOW_API_URL=https://platform-api.wisprflow.ai/api/v1/dash/api
WISPR_FLOW_WARMUP_URL=https://platform-api.wisprflow.ai/api/v1/dash/warmup_dash

# --- AI & LEGAL REASONING: GOOGLE GEMINI ---
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- DATABASE & PERSISTENCE: SUPABASE (Optional - SQLite is auto-initialized) ---
# Obtain from https://supabase.com/dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- SECONDARY SPEECH FALLBACKS (Optional) ---
GROQ_API_KEY=your_groq_api_key_here
WHISPER_API_KEY=your_openai_api_key_here
